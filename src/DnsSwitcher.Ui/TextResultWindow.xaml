<Window x:Class="DnsSwitcher.Ui.TextResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnsSwitcher"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        MinWidth="520"
        MinHeight="340"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource CardStyle}" Padding="0">
      <TextBox x:Name="ContentTextBox"
               IsReadOnly="True"
               BorderThickness="0"
               Background="Transparent"
               Style="{StaticResource MonospaceTextBoxStyle}" />
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="CopyButton"
              Grid.Column="0"
              Margin="0,0,6,0"
              Style="{StaticResource IconButtonStyle}"
              Click="OnCopyClicked"
              Content="&#xE8C8;"
              ToolTip="Ctrl+C"
              AutomationProperties.Name="Copy" />
      <Button x:Name="SelectAllButton"
              Grid.Column="1"
              Style="{StaticResource IconButtonStyle}"
              Click="OnSelectAllClicked"
              Content="&#xE8B3;"
              ToolTip="Ctrl+A"
              AutomationProperties.Name="Select all" />
      <Button x:Name="CloseButton"
              Grid.Column="3"
              Width="96"
              IsDefault="True"
              IsCancel="True"
              Click="OnOkClicked"
              Content="OK" />
    </Grid>
  </Grid>
</Window>
