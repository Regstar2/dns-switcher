<Window x:Class="DnsSwitcher.Ui.HealthFailoverSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Health Failover"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <GroupBox Header="Monitor">
            <Grid Margin="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <CheckBox x:Name="EnabledCheckBox"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,12"
                        Content="Enable DNS health monitor" />

              <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Interval, sec:" />
              <TextBox x:Name="IntervalTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Failure threshold:" />
              <TextBox x:Name="FailureThresholdTextBox" Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Recovery threshold:" />
              <TextBox x:Name="RecoveryThresholdTextBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" />

              <TextBlock Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Cooldown, sec:" />
              <TextBox x:Name="CooldownTextBox" Grid.Row="4" Grid.Column="2" Margin="0,0,0,8" />

              <TextBlock Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Check mode:" />
              <ComboBox x:Name="CheckModeComboBox"
                        Grid.Row="5"
                        Grid.Column="2"
                        Margin="0,0,0,8"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Mode" />

              <TextBlock Grid.Row="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="Action on failure:" />
              <ComboBox x:Name="ActionComboBox"
                        Grid.Row="6"
                        Grid.Column="2"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Action" />
            </Grid>
          </GroupBox>

          <GroupBox Margin="0,12,0,0" Header="Test Domains">
            <StackPanel Margin="12">
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap"
                         Text="One domain per line. These domains are used by the agent monitor and manual health check." />
              <TextBox x:Name="TestDomainsTextBox"
                       MinHeight="120"
                       Margin="0,8,0,0"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap" />
            </StackPanel>
          </GroupBox>

          <GroupBox Margin="0,12,0,0" Header="Expected IPs">
            <StackPanel Margin="12">
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap"
                         Text="Optional. Use only when DNS answers are stable. Format: domain=ip1,ip2" />
              <TextBox x:Name="ExpectedAddressesTextBox"
                       MinHeight="96"
                       Margin="0,8,0,0"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap" />
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <GroupBox Header="Failover Target">
            <Grid Margin="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Fallback profile:" />
              <ComboBox x:Name="FallbackProfileComboBox"
                        Grid.Column="2"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="ProfileId" />

              <TextBlock Grid.Row="1"
                         Grid.ColumnSpan="3"
                         Margin="0,12,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap"
                         Text="Fallback profile is used only when action is 'switch to fallback profile'. Chain is used by 'switch to next profile'." />
            </Grid>
          </GroupBox>

          <GroupBox Margin="0,12,0,0" Header="Failover Chain">
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ChainProfileComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="ProfileId" />
                <Button Grid.Column="1"
                        Width="84"
                        Margin="8,0,0,0"
                        Click="OnAddChainProfileClicked"
                        Content="Add" />
              </Grid>

              <ListBox x:Name="FailoverChainListBox"
                       Grid.Row="1"
                       MinHeight="132"
                       Margin="0,8,0,8" />

              <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <Button Width="86" Margin="0,0,8,0" Click="OnMoveChainUpClicked" Content="Up" />
                <Button Width="86" Margin="0,0,8,0" Click="OnMoveChainDownClicked" Content="Down" />
                <Button Width="96" Style="{StaticResource DangerActionButtonStyle}" Click="OnRemoveChainProfileClicked" Content="Remove" />
              </WrapPanel>
            </Grid>
          </GroupBox>

          <GroupBox Margin="0,12,0,0" Header="Current Health State">
            <TextBox x:Name="StateTextBox"
                     Margin="12"
                     MinHeight="160"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
          </GroupBox>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="120"
              Margin="0,0,8,0"
              Click="OnRunCheckClicked"
              Content="Run Check" />
      <Button Width="96"
              Margin="0,0,8,0"
              IsCancel="True"
              Content="Cancel" />
      <Button Width="96"
              IsDefault="True"
              Click="OnSaveClicked"
              Content="Save" />
    </StackPanel>
  </Grid>
</Window>
