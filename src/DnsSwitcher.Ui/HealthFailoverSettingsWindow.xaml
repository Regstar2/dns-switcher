<Window x:Class="DnsSwitcher.Ui.HealthFailoverSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Health Failover"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource PageHeaderTextStyle}" />
      <CheckBox x:Name="EnabledCheckBox"
                Grid.Column="1"
                Padding="6"
                VerticalAlignment="Center"
                Content="Enable DNS health monitor" />
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <GroupBox x:Name="MonitorGroupBox" Header="Monitor">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock x:Name="IntervalLabelTextBlock" Grid.Row="0" Style="{StaticResource SecondaryTextStyle}" Text="Interval, sec:" />
              <TextBox x:Name="IntervalTextBox" Grid.Row="1" Margin="0,4,0,10" />
              <TextBlock x:Name="FailureThresholdLabelTextBlock" Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="Failure threshold:" />
              <TextBox x:Name="FailureThresholdTextBox" Grid.Row="3" Margin="0,4,0,0" />

              <TextBlock x:Name="RecoveryThresholdLabelTextBlock" Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="Recovery threshold:" />
              <TextBox x:Name="RecoveryThresholdTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,10" />
              <TextBlock x:Name="CooldownLabelTextBlock" Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="Cooldown, sec:" />
              <TextBox x:Name="CooldownTextBox" Grid.Row="3" Grid.Column="2" Margin="0,4,0,0" />

              <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="CheckModeLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Check mode:" />
                  <ComboBox x:Name="CheckModeComboBox" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectedValuePath="Mode" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="ActionOnFailureLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Action on failure:" />
                  <ComboBox x:Name="ActionComboBox" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectedValuePath="Action" />
                </StackPanel>
              </Grid>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TestDomainsGroupBox" Margin="0,12,0,0" Header="Test Domains">
            <StackPanel>
              <TextBlock x:Name="TestDomainsHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="One domain per line." />
              <TextBox x:Name="TestDomainsTextBox" MinHeight="96" Margin="0,8,0,0" Style="{StaticResource MultilineTextBoxStyle}" />
            </StackPanel>
          </GroupBox>

          <GroupBox x:Name="ExpectedIpsGroupBox" Margin="0,12,0,0" Header="Expected IPs">
            <StackPanel>
              <TextBlock x:Name="ExpectedIpsHintTextBlock" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="Optional. Format: domain=ip1,ip2" />
              <TextBox x:Name="ExpectedAddressesTextBox" MinHeight="84" Margin="0,8,0,0" Style="{StaticResource MultilineTextBoxStyle}" />
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <GroupBox x:Name="CurrentHealthStateGroupBox" Header="Current Health State">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock x:Name="StateStatusLabelTextBlock" Style="{StaticResource CaptionTextStyle}" Text="Status:" />
                  <TextBlock x:Name="StateStatusValueTextBlock" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="StateActiveProfileLabelTextBlock" Style="{StaticResource CaptionTextStyle}" Text="Active profile:" />
                  <TextBlock x:Name="StateActiveProfileValueTextBlock" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="—" />
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock x:Name="StateFailuresLabelTextBlock" Style="{StaticResource CaptionTextStyle}" Text="Failures:" />
                  <TextBlock x:Name="StateFailuresValueTextBlock" Margin="0,3,0,0" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="StateLastCheckLabelTextBlock" Style="{StaticResource CaptionTextStyle}" Text="Last check:" />
                  <TextBlock x:Name="StateLastCheckValueTextBlock" Margin="0,3,0,0" TextWrapping="Wrap" Text="—" />
                </StackPanel>
              </Grid>
              <Expander Margin="0,12,0,0" IsExpanded="False">
                <Expander.Header>
                  <TextBlock x:Name="StateDetailsHeaderTextBlock" FontWeight="SemiBold" Text="More" />
                </Expander.Header>
                <TextBox x:Name="StateTextBox" Margin="0,8,0,0" MinHeight="130" IsReadOnly="True" Style="{StaticResource MonospaceTextBoxStyle}" />
              </Expander>
            </StackPanel>
          </GroupBox>

          <GroupBox x:Name="FailoverTargetGroupBox" Margin="0,12,0,0" Header="Failover Target">
            <StackPanel>
              <TextBlock x:Name="FallbackProfileLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Fallback profile:" />
              <ComboBox x:Name="FallbackProfileComboBox" Margin="0,5,0,0" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" />
              <TextBlock x:Name="FallbackHintTextBlock" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="Fallback profile is used when configured." />
            </StackPanel>
          </GroupBox>

          <GroupBox x:Name="FailoverChainGroupBox" Margin="0,12,0,0" Header="Failover Chain">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ChainProfileComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" />
                <Button x:Name="AddChainButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="OnAddChainProfileClicked" Content="Add" />
              </Grid>
              <ListBox x:Name="FailoverChainListBox" Grid.Row="1" MinHeight="120" Margin="0,8,0,8" />
              <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <Button x:Name="MoveChainUpButton" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="OnMoveChainUpClicked" Content="Up" />
                <Button x:Name="MoveChainDownButton" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="OnMoveChainDownClicked" Content="Down" />
                <Button x:Name="RemoveChainButton" Style="{StaticResource DangerActionButtonStyle}" Click="OnRemoveChainProfileClicked" Content="Remove" />
              </WrapPanel>
            </Grid>
          </GroupBox>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="RunCheckButton" MinWidth="120" Margin="0,0,8,0" Click="OnRunCheckClicked" Content="Run Check" />
      <Button x:Name="CancelButton" Width="100" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
      <Button x:Name="SaveButton" Width="110" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnSaveClicked" Content="Save" />
    </StackPanel>
  </Grid>
</Window>
