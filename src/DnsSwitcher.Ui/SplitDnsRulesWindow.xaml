<Window x:Class="DnsSwitcher.Ui.SplitDnsRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split DNS"
        Width="940"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="10"
            Background="{DynamicResource InfoStatusBrush}"
            CornerRadius="8">
      <TextBlock TextWrapping="Wrap"
                 Text="Split DNS uses Windows NRPT rules. Apply/reset requires DnsSwitcher Agent or administrator rights. Apps with their own DNS/DoH stack can bypass Windows NRPT." />
    </Border>

    <Grid Grid.Row="1"
          Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.1*" />
      </Grid.ColumnDefinitions>

      <GroupBox Header="Rules">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <CheckBox x:Name="SplitDnsEnabledCheckBox"
                    Margin="0,0,0,8"
                    Checked="OnSplitDnsEnabledChanged"
                    Unchecked="OnSplitDnsEnabledChanged"
                    Content="Enable Split DNS configuration" />

          <ListBox x:Name="RulesListBox"
                   Grid.Row="1"
                   SelectionChanged="OnRuleSelectionChanged" />

          <WrapPanel Grid.Row="2"
                     Margin="0,10,0,0"
                     HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Click="OnNewRuleClicked" Content="New" />
            <Button Width="90" Margin="0,0,8,0" Click="OnDeleteRuleClicked" Style="{StaticResource DangerActionButtonStyle}" Content="Delete" />
            <Button Width="90" Click="OnRefreshClicked" Content="Refresh" />
          </WrapPanel>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="2"
                Header="Rule Editor">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Rule ID:" />
          <TextBox x:Name="RuleIdTextBox" Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Namespace:" />
          <TextBox x:Name="NamespaceTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" ToolTip="Examples: *.example.com, .example.com, internal.corp.local" />

          <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Target profile:" />
          <ComboBox x:Name="TargetProfileComboBox"
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="0,0,0,8"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="ProfileId" />

          <TextBlock Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Priority:" />
          <TextBox x:Name="PriorityTextBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" />

          <TextBlock Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Enabled:" />
          <CheckBox x:Name="RuleEnabledCheckBox" Grid.Row="4" Grid.Column="2" Margin="0,0,0,8" />

          <TextBlock Grid.Row="5" VerticalAlignment="Top" FontWeight="SemiBold" Text="Comment:" />
          <TextBox x:Name="CommentTextBox"
                   Grid.Row="5"
                   Grid.Column="2"
                   Height="64"
                   Margin="0,0,0,8"
                   AcceptsReturn="True"
                   TextWrapping="Wrap" />

          <WrapPanel Grid.Row="6"
                     Grid.ColumnSpan="3"
                     Margin="0,4,0,12"
                     HorizontalAlignment="Right">
            <Button Width="120" Margin="0,0,8,0" Click="OnSaveRuleClicked" Content="Save Rule" />
            <Button Width="120" Click="OnToggleRuleClicked" Content="Toggle Rule" />
          </WrapPanel>

          <GroupBox Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Header="Test / Status">
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBox x:Name="TestDomainTextBox"
                       Margin="0,0,8,8"
                       ToolTip="Domain to test against current rules" />
              <Button Grid.Column="1"
                      Width="96"
                      Margin="0,0,0,8"
                      Click="OnTestRuleClicked"
                      Content="Test" />

              <TextBox x:Name="StatusTextBox"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       IsReadOnly="True"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" />
            </Grid>
          </GroupBox>
        </Grid>
      </GroupBox>
    </Grid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="120" Margin="0,0,8,0" Click="OnApplyRulesClicked" Content="Apply Rules" />
      <Button Width="120" Margin="0,0,8,0" Style="{StaticResource DangerActionButtonStyle}" Click="OnResetRulesClicked" Content="Reset Rules" />
      <Button Width="96" IsCancel="True" Click="OnCloseClicked" Content="Close" />
    </StackPanel>
  </Grid>
</Window>
