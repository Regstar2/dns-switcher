<Window x:Class="DnsSwitcher.Ui.SplitDnsRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split DNS"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource PageHeaderTextStyle}" />
      <CheckBox x:Name="SplitDnsEnabledCheckBox"
                Grid.Column="1"
                Padding="6"
                Checked="OnSplitDnsEnabledChanged"
                Unchecked="OnSplitDnsEnabledChanged"
                Content="Enable Split DNS configuration" />
    </Grid>

    <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource InfoBannerStyle}">
      <TextBlock x:Name="SplitDnsWarningTextBlock" TextWrapping="Wrap" Text="Split DNS uses Windows NRPT rules." />
    </Border>

    <Grid Grid.Row="2" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <GroupBox x:Name="RulesGroupBox" Grid.Column="0" Header="Rules">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="NewRuleButton" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="OnNewRuleClicked" Content="New" />
            <Button x:Name="DeleteRuleButton" Margin="0,0,6,0" Style="{StaticResource DangerActionButtonStyle}" Click="OnDeleteRuleClicked" Content="Delete" />
            <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnRefreshClicked" Content="Refresh" />
          </WrapPanel>
          <ListBox x:Name="RulesListBox" Grid.Row="1" SelectionChanged="OnRuleSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Rule.Namespace}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                    <Run Text="→ " /><Run Text="{Binding ProfileName}" />
                  </TextBlock>
                  <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding EnabledText}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </GroupBox>

      <GroupBox x:Name="RuleEditorGroupBox" Grid.Column="2" Header="Rule Editor">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock x:Name="NamespaceLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Namespace:" />
            <TextBox x:Name="NamespaceTextBox" Margin="0,4,0,10" ToolTip="Examples: *.example.com, .example.com, internal.corp.local" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock x:Name="TargetProfileLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Target profile:" />
            <ComboBox x:Name="TargetProfileComboBox" Margin="0,4,0,10" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock x:Name="RuleIdLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Rule ID:" />
            <TextBox x:Name="RuleIdTextBox" Margin="0,4,0,10" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock x:Name="PriorityLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Priority:" />
            <TextBox x:Name="PriorityTextBox" Margin="0,4,0,10" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
            <TextBlock x:Name="CommentLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Comment:" />
            <TextBox x:Name="CommentTextBox" Height="68" Margin="0,4,0,10" Style="{StaticResource MultilineTextBoxStyle}" />
          </StackPanel>

          <Grid Grid.Row="3" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <CheckBox x:Name="RuleEnabledCheckBox" Padding="2,6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="RuleEnabledLabelTextBlock" Text="Enabled:" />
              </StackPanel>
            </CheckBox>
            <Button x:Name="SaveRuleButton" Grid.Column="1" MinWidth="120" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnSaveRuleClicked" Content="Save Rule" />
            <Button x:Name="ToggleRuleButton" Visibility="Collapsed" Click="OnToggleRuleClicked" Content="Toggle Rule" />
          </Grid>

          <GroupBox x:Name="TestStatusGroupBox" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,0" Header="Test / Status">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="TestDomainTextBox" Margin="0,0,8,8" ToolTip="Domain to test against current rules" />
              <Button x:Name="TestRuleButton" Grid.Column="1" MinWidth="90" Margin="0,0,0,8" Click="OnTestRuleClicked" Content="Test" />
              <TextBox x:Name="StatusTextBox" Grid.Row="1" Grid.ColumnSpan="2" MinHeight="92" MaxHeight="130" IsReadOnly="True" Style="{StaticResource MonospaceTextBoxStyle}" />
            </Grid>
          </GroupBox>
        </Grid>
      </GroupBox>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ApplyRulesButton" MinWidth="130" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnApplyRulesClicked" Content="Apply Rules" />
      <Button x:Name="ResetRulesButton" MinWidth="130" Margin="0,0,8,0" Style="{StaticResource DangerActionButtonStyle}" Click="OnResetRulesClicked" Content="Reset Rules" />
      <Button x:Name="CloseButton" Width="100" IsCancel="True" Click="OnCloseClicked" Content="Close" />
    </StackPanel>
  </Grid>
</Window>
