<Window x:Class="DnsSwitcher.Ui.AgentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Manager"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HintTextBlock"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}"
               Text="The agent is a Windows Service used for privileged DNS operations. Install/reinstall/start/stop require UAC." />

    <TextBox x:Name="StatusTextBox"
             Grid.Row="1"
             Margin="0,12,0,12"
             IsReadOnly="True"
             FontFamily="Consolas"
             FontSize="12"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="InstallButton"
              Grid.Column="0"
              Margin="0,0,8,0"
              Click="OnInstallClicked"
              Content="Install" />
      <Button x:Name="ReinstallButton"
              Grid.Column="1"
              Margin="0,0,8,0"
              Click="OnReinstallClicked"
              Content="Reinstall" />
      <Button x:Name="StartButton"
              Grid.Column="2"
              Margin="0,0,8,0"
              Click="OnStartClicked"
              Content="Start" />
      <Button x:Name="StopButton"
              Grid.Column="3"
              Margin="0,0,8,0"
              Click="OnStopClicked"
              Content="Stop" />
      <Button x:Name="UninstallButton"
              Grid.Column="4"
              Margin="0,0,8,0"
              Style="{StaticResource DangerActionButtonStyle}"
              Click="OnUninstallClicked"
              Content="Uninstall" />
      <Button x:Name="RefreshButton"
              Grid.Column="5"
              Margin="0,0,8,0"
              Click="OnRefreshClicked"
              Content="Refresh" />
      <Button x:Name="CloseButton"
              Grid.Column="6"
              Width="96"
              IsCancel="True"
              Click="OnCloseClicked"
              Content="Close" />
    </Grid>
  </Grid>
</Window>
