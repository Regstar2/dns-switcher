<Window x:Class="DnsSwitcher.Ui.AgentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Manager"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource PageHeaderTextStyle}" />
      <TextBlock x:Name="HintTextBlock"
                 Margin="0,6,0,0"
                 Style="{StaticResource SecondaryTextStyle}"
                 TextWrapping="Wrap"
                 Text="The agent is a Windows Service used for privileged DNS operations." />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="ServiceStatusLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Service status:" />
          <TextBlock x:Name="ServiceStatusValueTextBlock" Margin="0,4,0,0" Style="{StaticResource StatusHeadingTextStyle}" Text="—" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="AgentConnectionLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Agent available:" />
          <TextBlock x:Name="AgentConnectionValueTextBlock" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="—" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardStyle}">
      <WrapPanel>
        <Button x:Name="InstallButton" Margin="0,0,8,8" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnInstallClicked" Content="Install" />
        <Button x:Name="ReinstallButton" Margin="0,0,8,8" Click="OnReinstallClicked" Content="Reinstall" />
        <Button x:Name="StartButton" Margin="0,0,8,8" Click="OnStartClicked" Content="Start" />
        <Button x:Name="StopButton" Margin="0,0,8,8" Click="OnStopClicked" Content="Stop" />
        <Button x:Name="UninstallButton" Margin="0,0,8,8" Style="{StaticResource DangerActionButtonStyle}" Click="OnUninstallClicked" Content="Uninstall" />
        <Button x:Name="RefreshButton" Margin="0,0,0,8" Style="{StaticResource ToolbarButtonStyle}" Click="OnRefreshClicked" Content="Refresh" />
      </WrapPanel>
    </Border>

    <Expander Grid.Row="3" Margin="0,12,0,0" IsExpanded="False">
      <Expander.Header>
        <TextBlock x:Name="TechnicalHeaderTextBlock" FontWeight="SemiBold" Text="More" />
      </Expander.Header>
      <TextBox x:Name="StatusTextBox"
               Margin="0,10,0,0"
               MinHeight="180"
               IsReadOnly="True"
               Style="{StaticResource MonospaceTextBoxStyle}" />
    </Expander>

    <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Width="100" IsCancel="True" Click="OnCloseClicked" Content="Close" />
    </StackPanel>
  </Grid>
</Window>
