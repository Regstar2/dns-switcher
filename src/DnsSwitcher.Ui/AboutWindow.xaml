<Window x:Class="DnsSwitcher.Ui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="700"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="AboutSectionStyle" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="ProductNameTextBlock"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="VersionTextBlock"
                   Margin="0,4,0,8"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock x:Name="SummaryTextBlock"
                   Margin="0,0,0,18"
                   FontSize="14"
                   TextWrapping="Wrap" />

        <Border Style="{StaticResource AboutSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="CapabilitiesHeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7" />
            <TextBlock x:Name="CapabilitiesTextBlock"
                       TextWrapping="Wrap"
                       LineHeight="21" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="ArchitectureHeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7" />
            <TextBlock x:Name="ArchitectureTextBlock"
                       TextWrapping="Wrap"
                       LineHeight="21" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource AboutSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="LicenseHeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7" />
            <TextBlock x:Name="LicenseTextBlock"
                       TextWrapping="Wrap"
                       LineHeight="21" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="GitHubButton"
              Grid.Column="1"
              MinWidth="130"
              Margin="0,0,8,0"
              Padding="12,6"
              Click="OnOpenGitHubClicked" />
      <Button x:Name="CloseButton"
              Grid.Column="2"
              MinWidth="100"
              Padding="12,6"
              IsCancel="True"
              Click="OnCloseClicked" />
    </Grid>
  </Grid>
</Window>
