<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF8FAFC" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111827" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF4B5563" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FFD1D5DB" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FFF0F3F6" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FFE8EDF2" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FFE9EDF2" />
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FFEDF3F9" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FF1F3D73" />
  <SolidColorBrush x:Key="PrimaryActionBrush" Color="#FFDCEAF8" />
  <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FFD7E6F5" />
  <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#FFCFE0F1" />
  <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FF173B67" />
  <SolidColorBrush x:Key="DangerActionBorderBrush" Color="#FFD08C8C" />
  <SolidColorBrush x:Key="DangerActionForegroundBrush" Color="#FF9F1D1D" />
  <SolidColorBrush x:Key="DangerActionHoverBrush" Color="#FFFBE9E9" />
  <SolidColorBrush x:Key="DangerActionPressedBrush" Color="#FFF7D9D9" />
  <SolidColorBrush x:Key="InfoStatusBrush" Color="#FFEFF6FF" />
  <SolidColorBrush x:Key="ErrorStatusBrush" Color="#FFFEE2E2" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF991B1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF111827" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF111827" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFE9EDF2" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF111827" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFEDF3F9" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF111827" />
</ResourceDictionary>
