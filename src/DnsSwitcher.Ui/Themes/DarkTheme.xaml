<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1D21" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF25282D" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF2B2F35" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FF202328" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFB7BDC6" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FF3E444D" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF30343B" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FF353A42" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF3A4048" />
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FF30353C" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="PrimaryActionBrush" Color="#FF46515D" />
  <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FF4D5864" />
  <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#FF566474" />
  <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFF7F9FB" />
  <SolidColorBrush x:Key="DangerActionBorderBrush" Color="#FF9C5A5A" />
  <SolidColorBrush x:Key="DangerActionForegroundBrush" Color="#FFF2B3B3" />
  <SolidColorBrush x:Key="DangerActionHoverBrush" Color="#FF3D2A2A" />
  <SolidColorBrush x:Key="DangerActionPressedBrush" Color="#FF4A3030" />
  <SolidColorBrush x:Key="InfoStatusBrush" Color="#FF2B2F35" />
  <SolidColorBrush x:Key="ErrorStatusBrush" Color="#FF4A2323" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFF2B3B3" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2B2F35" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2F35" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3A4048" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF3F4F6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF30353C" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF3F4F6" />
</ResourceDictionary>
