<Window x:Class="DnsSwitcher.Ui.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help"
        Width="760"
        Height="720"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="HelpSectionStyle" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <DataTemplate x:Key="HelpSectionTemplate">
      <Border Style="{StaticResource HelpSectionStyle}">
        <StackPanel>
          <TextBlock Text="{Binding Title}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Margin="0,0,0,7" />
          <TextBlock Text="{Binding Body}"
                     TextWrapping="Wrap"
                     LineHeight="21" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="HeaderTextBlock"
                 FontSize="26"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="IntroTextBlock"
                 Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap"
                 LineHeight="21" />
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="SectionsItemsControl"
                    ItemTemplate="{StaticResource HelpSectionTemplate}" />
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="CloseButton"
              Grid.Column="1"
              MinWidth="100"
              Padding="12,6"
              IsCancel="True"
              Click="OnCloseClicked" />
    </Grid>
  </Grid>
</Window>
