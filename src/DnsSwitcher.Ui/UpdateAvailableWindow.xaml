<Window x:Class="DnsSwitcher.Ui.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnsSwitcher update"
        Width="540"
        SizeToContent="Height"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="TitleTextBlock" FontSize="21" FontWeight="SemiBold" />
      <TextBlock x:Name="VersionTextBlock" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="DetailsTextBlock" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
      <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
    </Border>

    <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />

    <WrapPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right">
      <Button x:Name="ReleaseNotesButton" MinWidth="126" Height="38" Margin="0,0,8,0" Click="OnReleaseNotesClicked" />
      <Button x:Name="LaterButton" MinWidth="94" Height="38" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="InstallButton" MinWidth="154" Height="38" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnInstallClicked" />
    </WrapPanel>
  </Grid>
</Window>
