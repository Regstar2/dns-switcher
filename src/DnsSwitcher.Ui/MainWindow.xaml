<Window x:Class="DnsSwitcher.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:DnsSwitcher.Ui.UiModels"
        mc:Ignorable="d"
        Title="DnsSwitcher"
        Height="550"
        Width="980"
        WindowStartupLocation="CenterScreen"
        MinHeight="440"
        MinWidth="420"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type ui:ProfileListItem}">
      <Border Padding="2">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding Name}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border Margin="6,0,0,0"
                    Padding="6,1"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Right">
              <TextBlock Text="{Binding ModeText}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentTextBrush}" />
            </Border>
          </DockPanel>
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding StatusText}"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     FontSize="11"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding SummaryText}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <GroupBox x:Name="ProfilesGroupBox"
                Header="Profiles"
                Margin="0,0,6,0">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListBox x:Name="ProfilesListBox"
                   MinHeight="120"
                   SelectionChanged="OnProfileSelectionChanged"
                   HorizontalContentAlignment="Stretch" />

          <Grid Grid.Row="1"
                Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CreateProfileButton"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Click="OnCreateProfileClicked"
                    Content="Create" />
            <Button x:Name="EditProfileButton"
                    Grid.Column="1"
                    Margin="0,0,8,8"
                    Click="OnEditProfileClicked"
                    Content="Edit" />
            <Button x:Name="DeleteProfileButton"
                    Grid.Column="2"
                    Margin="0,0,0,8"
                    Style="{StaticResource DangerActionButtonStyle}"
                    Click="OnDeleteProfileClicked"
                    Content="Delete" />
          </Grid>

          <Grid Grid.Row="2"
                Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ApplyButton"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Click="OnApplyClicked"
                    Content="Apply" />
            <Button x:Name="ResetButton"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Click="OnResetClicked"
                    Content="Reset" />
          </Grid>

          <Grid Grid.Row="3"
                Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ChecksButton"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Click="OnOpenChecksClicked"
                    Content="Checks">
              <Button.ContextMenu>
                <ContextMenu x:Name="ChecksContextMenu"
                             Placement="Bottom">
                  <MenuItem x:Name="TestDnsMenuItem"
                            Click="OnTestCurrentDnsClicked"
                            Header="Test DNS" />
                  <MenuItem x:Name="TestSitesMenuItem"
                            Click="OnTestSitesClicked"
                            Header="Test Sites" />
                  <MenuItem x:Name="BenchmarkMenuItem"
                            Click="OnBenchmarkClicked"
                            Header="Benchmark" />
                  <MenuItem x:Name="HealthCheckMenuItem"
                            Click="OnHealthCheckClicked"
                            Header="Health Check" />
                  <Separator />
                  <MenuItem x:Name="HealthEnableMenuItem"
                            Click="OnHealthEnableClicked"
                            Header="Enable Health Monitor" />
                  <MenuItem x:Name="HealthDisableMenuItem"
                            Click="OnHealthDisableClicked"
                            Header="Disable Health Monitor" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="MoreToolsButton"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Click="OnOpenMoreToolsClicked"
                    Content="Import / Export">
              <Button.ContextMenu>
                <ContextMenu x:Name="MoreToolsContextMenu"
                             Placement="Bottom">
                  <MenuItem x:Name="ImportProfilesMenuItem"
                            Click="OnImportProfilesClicked"
                            Header="Import" />
                  <MenuItem x:Name="ExportProfileMenuItem"
                            Click="OnExportProfileClicked"
                            Header="Export" />
                  <Separator />
                  <MenuItem x:Name="SplitDnsStatusMenuItem"
                            Click="OnSplitDnsStatusClicked"
                            Header="Split DNS Status" />
                  <MenuItem x:Name="SplitDnsApplyMenuItem"
                            Click="OnSplitDnsApplyClicked"
                            Header="Apply Split DNS" />
                  <MenuItem x:Name="SplitDnsResetMenuItem"
                            Click="OnSplitDnsResetClicked"
                            Header="Reset Split DNS" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </Grid>
        </Grid>
      </GroupBox>

      <Grid x:Name="DetailsPanel"
            Grid.Column="1"
            Margin="6,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox x:Name="AdapterGroupBox"
                  Grid.Row="0"
                  Margin="0,0,0,12"
                  Header="Adapter and App">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ComboBox x:Name="AdapterComboBox"
                        MinWidth="220"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="OnAdapterSelectionChanged" />
              <WrapPanel Grid.Column="1"
                         Margin="12,0,0,0">
                <Button x:Name="ReloadButton"
                        Width="84"
                        Click="OnRefreshClicked"
                        Content="Reload"
                        ToolTip="Reload profiles.json and current DNS status from disk, CLI, tray, and system state." />
              </WrapPanel>
            </Grid>
          </Grid>
        </GroupBox>

        <GroupBox x:Name="CurrentStatusGroupBox"
                  Grid.Row="1"
                  Margin="0,0,0,12"
                  VerticalAlignment="Top"
                  Header="Current Status">
          <Grid Margin="12"
                Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="StatusLabel" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="CurrentProfileLabelTextBlock" Grid.Row="0" Text="Current profile:" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentProfileValueTextBlock" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="ConfigActiveProfileLabelTextBlock" Grid.Row="1" Text="Config active profile:" FontWeight="SemiBold" />
            <TextBlock x:Name="ConfigActiveProfileValueTextBlock" Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="SelectedAdapterLabelTextBlock" Grid.Row="2" Text="Selected adapter:" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedAdapterValueTextBlock" Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="DnsModeLabelTextBlock" Grid.Row="3" Text="DNS mode:" FontWeight="SemiBold" />
            <TextBlock x:Name="DnsModeValueTextBlock" Grid.Row="3" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="AgentServiceLabelTextBlock" Grid.Row="4" Text="Agent service:" FontWeight="SemiBold" />
            <TextBlock x:Name="AgentServiceStatusValueTextBlock" Grid.Row="4" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="AgentAvailableLabelTextBlock" Grid.Row="5" Text="Agent available:" FontWeight="SemiBold" />
            <TextBlock x:Name="AgentAvailableValueTextBlock" Grid.Row="5" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="HealthMonitorLabelTextBlock" Grid.Row="6" Text="Health monitor:" FontWeight="SemiBold" />
            <TextBlock x:Name="HealthMonitorValueTextBlock" Grid.Row="6" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="SplitDnsLabelTextBlock" Grid.Row="7" Text="Split DNS:" FontWeight="SemiBold" />
            <TextBlock x:Name="SplitDnsValueTextBlock" Grid.Row="7" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="Ipv4LabelTextBlock" Grid.Row="8" Text="IPv4 DNS:" FontWeight="SemiBold" />
            <TextBlock x:Name="Ipv4ValueTextBlock" Grid.Row="8" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />

            <TextBlock x:Name="Ipv6LabelTextBlock" Grid.Row="9" Text="IPv6 DNS:" FontWeight="SemiBold" />
            <TextBlock x:Name="Ipv6ValueTextBlock" Grid.Row="9" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />
          </Grid>
        </GroupBox>

        <GroupBox x:Name="SelectedProfileGroupBox"
                  Grid.Row="2"
                  VerticalAlignment="Top"
                  Header="Selected Profile">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="StatusLabel" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ProfileLabelTextBlock" Grid.Row="0" Text="Profile:" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedProfileNameTextBlock" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" />

            <TextBlock x:Name="SummaryLabelTextBlock" Grid.Row="1" Text="Summary:" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedProfileSummaryTextBlock" Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" />

            <TextBlock x:Name="TagsLabelTextBlock" Grid.Row="2" Text="Tags:" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedProfileTagsTextBlock" Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" />
          </Grid>
        </GroupBox>
      </Grid>
    </Grid>

    <Grid x:Name="BottomBarGrid"
          Grid.Row="1"
          Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="OperationStatusBorder"
              Grid.Column="0"
              Margin="0,0,6,0"
              Padding="8,4"
              Background="{DynamicResource InfoStatusBrush}"
              CornerRadius="8">
        <TextBlock x:Name="OperationStatusTextBlock"
                   Text="Ready."
                   FontSize="12"
                   TextWrapping="Wrap" />
      </Border>

      <Grid x:Name="BottomActionsPanel"
            Grid.Column="1"
            Margin="6,0,0,0"
            VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button x:Name="AgentButton"
                Grid.Column="0"
                Margin="0,0,8,0"
                Click="OnOpenAgentManagerClicked"
                Content="Agent" />
        <Button x:Name="HealthSettingsButton"
                Grid.Column="1"
                Margin="0,0,8,0"
                Click="OnOpenHealthSettingsClicked"
                Content="Health" />
        <Button x:Name="SplitDnsButton"
                Grid.Column="2"
                Margin="0,0,8,0"
                Click="OnOpenSplitDnsRulesClicked"
                Content="Split DNS" />
        <Button x:Name="SettingsButton"
                Grid.Column="3"
                Margin="0,0,8,0"
                Click="OnOpenSettingsClicked"
                Content="Settings" />
        <Button x:Name="OpenConfigButton"
                Grid.Column="4"
                Margin="0,0,8,0"
                Click="OnOpenConfigFolderClicked"
                Content="Open Config" />
        <Button x:Name="OpenLogsButton"
                Grid.Column="5"
                Click="OnOpenLogsFolderClicked"
                Content="Open Logs" />
      </Grid>
    </Grid>
  </Grid>
</Window>
