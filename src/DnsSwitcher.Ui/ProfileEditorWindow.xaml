<Window x:Class="DnsSwitcher.Ui.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Profile"
        Width="640"
        Height="760"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IdLabelTextBlock"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Profile ID:" />
        <TextBox x:Name="IdTextBox"
                 Grid.Row="0"
                 Grid.Column="2"
                 Margin="0,0,0,12" />

        <TextBlock x:Name="NameLabelTextBlock"
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Profile name:" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Grid.Column="2"
                 Margin="0,0,0,12" />

        <TextBlock x:Name="DescriptionLabelTextBlock"
                   Grid.Row="2"
                   VerticalAlignment="Top"
                   FontWeight="SemiBold"
                   Text="Description:" />
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="2"
                 Grid.Column="2"
                 Height="64"
                 Margin="0,0,0,12"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="ModeLabelTextBlock"
                   Grid.Row="3"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Mode:" />
        <ComboBox x:Name="ModeComboBox"
                  Grid.Row="3"
                  Grid.Column="2"
                  Margin="0,0,0,12"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Mode"
                  SelectionChanged="OnModeSelectionChanged" />

        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,12">
          <TextBlock x:Name="Ipv4LabelTextBlock"
                     FontWeight="SemiBold"
                     Text="IPv4 DNS servers:" />
          <TextBlock x:Name="HintTextBlock"
                     Margin="0,4,0,6"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="One value per line." />
          <TextBox x:Name="Ipv4TextBox"
                   MinHeight="76"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,12">
          <TextBlock x:Name="Ipv6LabelTextBlock"
                     FontWeight="SemiBold"
                     Text="IPv6 DNS servers:" />
          <TextBox x:Name="Ipv6TextBox"
                   MinHeight="76"
                   Margin="0,6,0,0"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,12">
          <TextBlock x:Name="TagsLabelTextBlock"
                     FontWeight="SemiBold"
                     Text="Tags:" />
          <TextBox x:Name="TagsTextBox"
                   MinHeight="54"
                   Margin="0,6,0,0"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,12">
          <TextBlock x:Name="TestDomainsLabelTextBlock"
                     FontWeight="SemiBold"
                     Text="DNS test domains:" />
          <TextBox x:Name="TestDomainsTextBox"
                   MinHeight="80"
                   Margin="0,6,0,0"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="8"
                    Grid.ColumnSpan="3">
          <TextBlock x:Name="TestUrlsLabelTextBlock"
                     FontWeight="SemiBold"
                     Text="Site test URLs:" />
          <TextBox x:Name="TestUrlsTextBox"
                   MinHeight="96"
                   Margin="0,6,0,0"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Width="96"
              Margin="0,0,8,0"
              IsCancel="True"
              Content="Cancel" />
      <Button x:Name="SaveButton"
              Width="96"
              IsDefault="True"
              Click="OnSaveClicked"
              Content="Save" />
    </StackPanel>
  </Grid>
</Window>
