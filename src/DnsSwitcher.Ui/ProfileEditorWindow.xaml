<Window x:Class="DnsSwitcher.Ui.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Profile"
        Width="760"
        Height="640"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="NameLabelTextBlock" FontWeight="SemiBold" Text="Profile name:" />
            <TextBox x:Name="NameTextBox" Margin="0,6,0,14" TabIndex="0" />

            <TextBlock x:Name="ModeLabelTextBlock" FontWeight="SemiBold" Text="Mode:" />
            <ComboBox x:Name="ModeComboBox"
                      Margin="0,6,0,14"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Mode"
                      SelectionChanged="OnModeSelectionChanged"
                      TabIndex="1" />

            <TextBlock x:Name="DescriptionLabelTextBlock" FontWeight="SemiBold" Text="Description:" />
            <TextBox x:Name="DescriptionTextBox"
                     Height="76"
                     Margin="0,6,0,14"
                     Style="{StaticResource MultilineTextBoxStyle}"
                     TabIndex="2" />

            <TextBlock x:Name="IdLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Profile ID:" />
            <TextBox x:Name="IdTextBox" Margin="0,6,0,0" TabIndex="3" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="Ipv4LabelTextBlock" FontWeight="SemiBold" Text="IPv4 DNS servers:" />
            <TextBlock x:Name="HintTextBlock"
                       Margin="0,3,0,6"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="One value per line." />
            <TextBox x:Name="Ipv4TextBox"
                     MinHeight="100"
                     Style="{StaticResource MultilineTextBoxStyle}"
                     TabIndex="4" />

            <TextBlock x:Name="Ipv6LabelTextBlock" Margin="0,14,0,0" FontWeight="SemiBold" Text="IPv6 DNS servers:" />
            <TextBox x:Name="Ipv6TextBox"
                     MinHeight="100"
                     Margin="0,6,0,0"
                     Style="{StaticResource MultilineTextBoxStyle}"
                     TabIndex="5" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock x:Name="TagsLabelTextBlock" FontWeight="SemiBold" Text="Tags:" />
              <TextBox x:Name="TagsTextBox"
                       MinHeight="92"
                       Margin="0,6,0,0"
                       Style="{StaticResource MultilineTextBoxStyle}"
                       TabIndex="6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="TestDomainsLabelTextBlock" FontWeight="SemiBold" Text="DNS test domains:" />
              <TextBox x:Name="TestDomainsTextBox"
                       MinHeight="92"
                       Margin="0,6,0,0"
                       Style="{StaticResource MultilineTextBoxStyle}"
                       TabIndex="7" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock x:Name="TestUrlsLabelTextBlock" FontWeight="SemiBold" Text="Site test URLs:" />
              <TextBox x:Name="TestUrlsTextBox"
                       MinHeight="92"
                       Margin="0,6,0,0"
                       Style="{StaticResource MultilineTextBoxStyle}"
                       TabIndex="8" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Width="100"
              Margin="0,0,8,0"
              IsCancel="True"
              Content="Cancel"
              TabIndex="10" />
      <Button x:Name="SaveButton"
              Width="110"
              IsDefault="True"
              Style="{StaticResource PrimaryActionButtonStyle}"
              Click="OnSaveClicked"
              Content="Save"
              TabIndex="9" />
    </StackPanel>
  </Grid>
</Window>
