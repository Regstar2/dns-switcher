<Window x:Class="DnsSwitcher.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620"
        Height="640"
        MinWidth="580"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="SettingsSectionStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SettingsSectionHeaderStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="SettingsDescriptionStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsNavigationButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SettingsToggleStyle" TargetType="{x:Type CheckBox}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid Width="46" Height="26" SnapsToDevicePixels="True">
              <Border x:Name="Track" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" />
              <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="2,0,2,16">
      <TextBlock x:Name="SettingsHeaderTextBlock" FontSize="22" FontWeight="SemiBold" Text="Settings" />
      <TextBlock x:Name="SettingsSubtitleTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Application and related component preferences." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
      <StackPanel Margin="0,0,4,0">
        <Border Style="{StaticResource SettingsSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="GeneralHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderStyle}" Text="General" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="LanguageLabelTextBlock" FontWeight="SemiBold" Text="Language" />
                <TextBlock x:Name="LanguageDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Language used by the application interface." />
              </StackPanel>
              <ComboBox x:Name="LanguageComboBox" Grid.Column="2" Width="200" VerticalAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="Language" />
            </Grid>
            <Border Height="1" Margin="0,14" Background="{DynamicResource BorderBrush}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="ThemeLabelTextBlock" FontWeight="SemiBold" Text="Theme" />
                <TextBlock x:Name="ThemeCurrentTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Current theme: Dark" />
              </StackPanel>
              <ComboBox x:Name="ThemeComboBox" Grid.Column="2" Width="200" VerticalAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="Theme" SelectionChanged="OnThemeSelectionChanged" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="BehaviorHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Behavior" />
            <Grid MinHeight="52">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StartWithWindowsTitleTextBlock" FontWeight="SemiBold" Text="Start tray with Windows" />
                <TextBlock x:Name="StartWithWindowsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Start DnsSwitcher automatically after signing in to Windows." />
              </StackPanel>
              <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" />
            </Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="52">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="CloseToTrayTitleTextBlock" FontWeight="SemiBold" Text="Continue in tray on close" />
                <TextBlock x:Name="CloseToTrayDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Closing the window keeps DnsSwitcher running in the system tray." />
              </StackPanel>
              <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="SystemTrayHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderStyle}" Text="System tray" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayDnsActionsTitleTextBlock" FontWeight="SemiBold" Text="DNS actions"/><TextBlock x:Name="TrayDnsActionsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show quick DNS commands."/></StackPanel><CheckBox x:Name="ShowDnsActionsCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayDiagnosticsTitleTextBlock" FontWeight="SemiBold" Text="Diagnostics"/><TextBlock x:Name="TrayDiagnosticsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show diagnostic commands."/></StackPanel><CheckBox x:Name="ShowDiagnosticsCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayProfilesTitleTextBlock" FontWeight="SemiBold" Text="Profiles"/><TextBlock x:Name="TrayProfilesDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show profile selection."/></StackPanel><CheckBox x:Name="ShowProfilesCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TraySplitDnsTitleTextBlock" FontWeight="SemiBold" Text="Split DNS"/><TextBlock x:Name="TraySplitDnsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show Split DNS controls."/></StackPanel><CheckBox x:Name="ShowSplitDnsCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayAgentTitleTextBlock" FontWeight="SemiBold" Text="Agent"/><TextBlock x:Name="TrayAgentDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show Agent controls."/></StackPanel><CheckBox x:Name="ShowAgentCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayAdapterNameTitleTextBlock" FontWeight="SemiBold" Text="Adapter name"/><TextBlock x:Name="TrayAdapterNameDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show selected adapter."/></StackPanel><CheckBox x:Name="ShowAdapterNameCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
            <Border Height="1" Margin="0,10" Background="{DynamicResource BorderBrush}" />
            <Grid MinHeight="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="TrayNotificationsTitleTextBlock" FontWeight="SemiBold" Text="Notifications"/><TextBlock x:Name="TrayNotificationsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Show tray notifications."/></StackPanel><CheckBox x:Name="NotificationsEnabledCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}"/></Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsSectionStyle}" Padding="4,16,4,4">
          <StackPanel>
            <TextBlock x:Name="AdvancedHeaderTextBlock" Margin="12,0,12,5" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Advanced settings" />
            <Button x:Name="AgentManagerButton" Style="{StaticResource SettingsNavigationButtonStyle}" Click="OnAgentManagerClicked"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="AgentManagerTitleTextBlock" FontWeight="SemiBold" Text="Manage Agent"/><TextBlock x:Name="AgentManagerDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Manage the Agent service and its current state."/></StackPanel><Path Grid.Column="1" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 5 L 0 10" Stretch="Fill" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/></Grid></Button>
            <Border Height="1" Margin="12,0" Background="{DynamicResource BorderBrush}" />
            <Button x:Name="HealthSettingsButton" Style="{StaticResource SettingsNavigationButtonStyle}" Click="OnHealthSettingsClicked"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="HealthSettingsTitleTextBlock" FontWeight="SemiBold" Text="DNS Health"/><TextBlock x:Name="HealthSettingsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Configure DNS monitoring and automatic failover."/></StackPanel><Path Grid.Column="1" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 5 L 0 10" Stretch="Fill" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/></Grid></Button>
            <Border Height="1" Margin="12,0" Background="{DynamicResource BorderBrush}" />
            <Button x:Name="SplitDnsSettingsButton" Style="{StaticResource SettingsNavigationButtonStyle}" Click="OnSplitDnsSettingsClicked"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="SplitDnsSettingsTitleTextBlock" FontWeight="SemiBold" Text="Split DNS"/><TextBlock x:Name="SplitDnsSettingsDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Configure domain-specific DNS routing rules."/></StackPanel><Path Grid.Column="1" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 5 L 0 10" Stretch="Fill" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"/></Grid></Button>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="UpdatesHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Updates" />
            <Grid MinHeight="56">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="AutomaticUpdateChecksTitleTextBlock" FontWeight="SemiBold" Text="Automatically check for updates" />
                <TextBlock x:Name="AutomaticUpdateChecksDescriptionTextBlock" Margin="0,3,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Check the official release source in the background." />
              </StackPanel>
              <CheckBox x:Name="AutomaticUpdateChecksCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggleStyle}" />
            </Grid>
            <Button x:Name="CheckForUpdatesButton" MinWidth="170" Height="38" Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnCheckForUpdatesClicked" Content="Check for updates" />
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsSectionStyle}">
          <StackPanel>
            <TextBlock x:Name="AboutHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderStyle}" Text="About" />
            <TextBlock x:Name="AboutProductTextBlock" FontSize="17" FontWeight="SemiBold" Text="DnsSwitcher" />
            <TextBlock x:Name="AboutVersionTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Version" />
            <TextBlock x:Name="AboutDescriptionTextBlock" Margin="0,10,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Windows DNS profile switching, diagnostics, Health Failover and Split DNS." />
            <Border Height="1" Margin="0,14" Background="{DynamicResource BorderBrush}" />
            <TextBlock x:Name="HelpHeaderTextBlock" FontWeight="SemiBold" Text="Help" />
            <TextBlock x:Name="HelpDescriptionTextBlock" Margin="0,4,0,0" Style="{StaticResource SettingsDescriptionStyle}" Text="Documentation and source code are available on GitHub." />
            <Button x:Name="OpenGitHubButton" MinWidth="140" Height="38" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnOpenGitHubClicked" Content="Open GitHub" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Width="108" Height="38" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
      <Button x:Name="SaveButton" Width="108" Height="38" Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True" Click="OnSaveClicked" Content="Save" />
    </StackPanel>
  </Grid>
</Window>
