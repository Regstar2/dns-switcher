<Window x:Class="DnsSwitcher.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox x:Name="LanguageGroupBox"
              Header="Language">
      <Grid Margin="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LanguageLabelTextBlock"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Language:" />
        <ComboBox x:Name="LanguageComboBox"
                  Grid.Column="2"
                  MinWidth="180"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Language" />
      </Grid>
    </GroupBox>

    <GroupBox x:Name="BehaviorGroupBox"
              Grid.Row="1"
              Margin="0,12,0,0"
              Header="Behavior">
      <StackPanel Margin="12">
        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Content="Start tray with Windows" />
        <CheckBox x:Name="MinimizeToTrayCheckBox"
                  Margin="0,6,0,0"
                  Content="Continue in tray on close" />
        <Button x:Name="AgentManagerButton"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                MinWidth="180"
                Click="OnAgentManagerClicked"
                Content="Agent Manager" />
        <Button x:Name="HealthSettingsButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                MinWidth="180"
                Click="OnHealthSettingsClicked"
                Content="DNS Health" />
        <Button x:Name="SplitDnsSettingsButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                MinWidth="180"
                Click="OnSplitDnsSettingsClicked"
                Content="Split DNS" />
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="ThemeGroupBox"
              Grid.Row="2"
              Margin="0,12,0,0"
              Header="Theme">
      <StackPanel Margin="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="ThemeLabelTextBlock"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="Theme:" />
          <ComboBox x:Name="ThemeComboBox"
                    Grid.Column="2"
                    MinWidth="180"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Theme"
                    SelectionChanged="OnThemeSelectionChanged" />
        </Grid>

        <TextBlock x:Name="ThemeModeTextBlock"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="Theme follows the Windows system setting." />
        <TextBlock x:Name="ThemeCurrentTextBlock"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </GroupBox>

    <StackPanel Grid.Row="3"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Width="96"
              Margin="0,0,8,0"
              IsCancel="True"
              Content="Cancel" />
      <Button x:Name="SaveButton"
              Width="96"
              IsDefault="True"
              Click="OnSaveClicked"
              Content="Save" />
    </StackPanel>
  </Grid>
</Window>
