<Window x:Class="DnsSwitcher.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        Height="610"
        MinWidth="500"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
               Style="{StaticResource PageHeaderTextStyle}" />

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <GroupBox x:Name="LanguageGroupBox" Grid.Column="0" Header="Language">
            <StackPanel>
              <TextBlock x:Name="LanguageLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Language:" />
              <ComboBox x:Name="LanguageComboBox"
                        Margin="0,6,0,0"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Language"
                        TabIndex="0" />
            </StackPanel>
          </GroupBox>

          <GroupBox x:Name="ThemeGroupBox" Grid.Column="2" Header="Theme">
            <StackPanel>
              <TextBlock x:Name="ThemeLabelTextBlock" Style="{StaticResource SecondaryTextStyle}" Text="Theme:" />
              <ComboBox x:Name="ThemeComboBox"
                        Margin="0,6,0,0"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Theme"
                        SelectionChanged="OnThemeSelectionChanged"
                        TabIndex="1" />
              <TextBlock x:Name="ThemeModeTextBlock"
                         Margin="0,8,0,0"
                         Style="{StaticResource CaptionTextStyle}"
                         TextWrapping="Wrap"
                         Text="Theme follows the Windows system setting." />
              <TextBlock x:Name="ThemeCurrentTextBlock"
                         Margin="0,4,0,0"
                         Style="{StaticResource CaptionTextStyle}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </GroupBox>
        </Grid>

        <GroupBox x:Name="BehaviorGroupBox" Margin="0,12,0,0" Header="Behavior">
          <StackPanel>
            <CheckBox x:Name="StartWithWindowsCheckBox" Padding="2,4" Content="Start tray with Windows" TabIndex="2" />
            <CheckBox x:Name="MinimizeToTrayCheckBox" Margin="0,6,0,0" Padding="2,4" Content="Continue in tray on close" TabIndex="3" />

            <Border Margin="0,16,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Content, ElementName=AgentManagerButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="AgentManagerButton" Grid.Column="1" MinWidth="160" Style="{StaticResource ToolbarButtonStyle}" Click="OnAgentManagerClicked" Content="Agent Manager" TabIndex="4" />
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Content, ElementName=HealthSettingsButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="HealthSettingsButton" Grid.Column="1" MinWidth="160" Style="{StaticResource ToolbarButtonStyle}" Click="OnHealthSettingsClicked" Content="DNS Health" TabIndex="5" />
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Content, ElementName=SplitDnsSettingsButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="SplitDnsSettingsButton" Grid.Column="1" MinWidth="160" Style="{StaticResource ToolbarButtonStyle}" Click="OnSplitDnsSettingsClicked" Content="Split DNS" TabIndex="6" />
            </Grid>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Width="100" Margin="0,0,8,0" IsCancel="True" Content="Cancel" TabIndex="8" />
      <Button x:Name="SaveButton" Width="110" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnSaveClicked" Content="Save" TabIndex="7" />
    </StackPanel>
  </Grid>
</Window>
