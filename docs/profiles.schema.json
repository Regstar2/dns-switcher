{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dns-switcher.local/schemas/profiles.schema.json",
  "title": "DnsSwitcher profiles.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "activeProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "ipv4",
        "ipv6"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "static",
            "dhcp"
          ]
        },
        "ipv4": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        },
        "ipv6": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ipv6"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "dhcp"
              }
            }
          },
          "then": {
            "properties": {
              "ipv4": {
                "maxItems": 0
              },
              "ipv6": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "static"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "ipv4": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "ipv6": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
